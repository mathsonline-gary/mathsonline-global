{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@workspace/openapi-v2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./openapi.yaml": "./dist/openapi.yaml",
    "./types": "./dist/types.ts",
    "./client": "./src/client/index.ts"
  },
  "scripts": {
    "build": "redocly bundle main && redocly build-docs main --output dist/index.html && openapi-typescript",
    "lint": "redocly lint && eslint",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@redocly/cli": "^2.5.0",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9",
    "openapi-typescript": "^7.10.1",
    "typescript": "^5"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  }
}
