{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // Dependents type-check against `dist/types.ts`, which only exists after this package's build.
    // The transit node is what carries that ordering to them without every task depending on
    // every upstream build.
    "transit": {
      "dependsOn": ["^transit", "build"]
    },
    // Prism serves the bundle, not the source, so the mock cannot start before `build` has written
    // `dist/openapi.yaml`. Long-running and never cacheable, like any dev server.
    "mock": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    }
  }
}
