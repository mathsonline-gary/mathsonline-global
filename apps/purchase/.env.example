# Root of the API this app talks to, including the /api/v2 prefix. Not NEXT_PUBLIC_: requests are
# made from the server, and the browser has no business knowing the upstream host.
API_URL=http://localhost/api/v2

# To develop against the mock server instead of a real back end, run `pnpm mock` and use the line
# below. Note the missing /api/v2 — Prism mounts the paths at the root and ignores the `servers`
# base path, so the prefix would 404.
# API_URL=http://127.0.0.1:4010
